---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import { sitePath } from '../data/site';
---
<BaseLayout title="احجز تقييم — Rehalink" description="تواصل مع فريق Rehalink لحجز تقييم.">
  <section class="contact-page">
    <div class="container contact-layout">
      <div class="contact-intro">
        <span class="contact-kicker">خطوة بسيطة، وحوار واضح</span>
        <h1>احجز تقييم</h1>
        <p class="contact-lead">
          عمّر اسمك ورقم هاتفك، ونفتحو لك محادثة واتساب جاهزة باش تتواصل مع الفريق.
          راجع الرسالة قبل ما تبعثها.
        </p>

        <div class="contact-illustration">
          <span class="contact-orbit contact-orbit--one" aria-hidden="true"></span>
          <span class="contact-orbit contact-orbit--two" aria-hidden="true"></span>
          <img src={sitePath('/images/rehab-support.svg')} alt="" width="520" height="400" fetchpriority="high" />
          <span class="contact-art-note">نسمعك<br />ونرافقك</span>
        </div>

        <ul class="contact-benefits">
          <li><span aria-hidden="true">01</span><span><strong>بلا معلومات طبية</strong><small>ما نسقسيـوش على أعراض أو تشخيص في النموذج.</small></span></li>
          <li><span aria-hidden="true">02</span><span><strong>أنت تتحكم في الإرسال</strong><small>الرسالة تبقى مسودة حتى تراجعها وتضغط إرسال في واتساب.</small></span></li>
        </ul>
      </div>

      <div class="contact-form-panel">
        <div class="contact-form-heading">
          <span aria-hidden="true">✳</span>
          <div>
            <h2>خلّي لنا وسيلة نتواصلو معاك</h2>
            <p>الخانات اللي عليها نجمة مطلوبة.</p>
          </div>
        </div>
        <ContactForm />
        <p class="contact-email">
          تفضّل البريد الإلكتروني؟
          <a href="mailto:contact@rehalink.dz">contact@rehalink.dz</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page {
    position: relative;
    overflow: clip;
    padding-block: clamp(2.5rem, 6vw, 5.5rem);
    background:
      radial-gradient(ellipse at 18% 32%, rgba(184, 229, 207, 0.28), transparent 34%),
      radial-gradient(ellipse at 90% 75%, rgba(236, 230, 243, 0.45), transparent 35%);
  }

  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(19rem, 0.85fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  .contact-intro {
    min-width: 0;
  }

  .contact-kicker {
    display: inline-flex;
    padding: 0.35rem 0.7rem;
    border: 1px solid rgba(84, 135, 108, 0.2);
    border-radius: 999px;
    background: rgba(255, 253, 248, 0.76);
    color: #527d68;
    font-size: 0.78rem;
    font-weight: 800;
  }

  .contact-intro h1 {
    margin: 0.7rem 0 0.2rem;
    font-size: clamp(2.7rem, 5vw, 4.5rem);
    line-height: 1.15;
  }

  .contact-lead {
    max-width: 38rem;
    margin: 0;
    color: #536574;
    font-size: clamp(0.98rem, 1.5vw, 1.1rem);
    line-height: 1.9;
  }

  .contact-illustration {
    position: relative;
    isolation: isolate;
    width: min(100%, 31rem);
    aspect-ratio: 1.3;
    margin-block: 1.15rem 0.5rem;
  }

  .contact-illustration img {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 14px 20px rgba(36, 71, 103, 0.09));
  }

  .contact-orbit {
    position: absolute;
    z-index: -1;
    border-radius: 48% 52% 62% 38% / 45% 43% 57% 55%;
  }

  .contact-orbit--one {
    inset: 8% 12%;
    background: rgba(205, 232, 215, 0.72);
    transform: rotate(-9deg);
  }

  .contact-orbit--two {
    inset: 15% 4%;
    border: 1px solid rgba(112, 146, 125, 0.35);
    transform: rotate(10deg);
  }

  .contact-art-note {
    position: absolute;
    inset-block-end: 8%;
    inset-inline-start: 0;
    z-index: 2;
    padding: 0.6rem 0.85rem;
    border: 1px solid rgba(36, 71, 103, 0.1);
    border-radius: 5px 12px 4px 10px;
    background: #fffdf8;
    box-shadow: 0 7px 16px rgba(36, 71, 103, 0.12);
    color: var(--color-primary-dark);
    font-size: 0.78rem;
    font-weight: 800;
    line-height: 1.5;
    transform: rotate(-4deg);
  }

  .contact-benefits {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-benefits li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    min-width: 0;
    padding: 0.75rem;
    border: 1px solid rgba(36, 71, 103, 0.09);
    border-radius: 0.85rem;
    background: rgba(255, 253, 248, 0.76);
  }

  .contact-benefits li > span:first-child {
    display: grid;
    width: 1.8rem;
    height: 1.8rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    background: #e7f1e8;
    color: #527d68;
    font-size: 0.62rem;
    font-weight: 800;
  }

  .contact-benefits strong,
  .contact-benefits small {
    display: block;
  }

  .contact-benefits strong {
    color: var(--color-primary-dark);
    font-size: 0.8rem;
  }

  .contact-benefits small {
    margin-block-start: 0.15rem;
    color: var(--color-text-muted);
    font-size: 0.7rem;
    line-height: 1.65;
  }

  .contact-form-panel {
    min-width: 0;
    padding: clamp(1.1rem, 3vw, 2rem);
    border: 1px solid rgba(36, 71, 103, 0.11);
    border-radius: 1.4rem 1.1rem 1.5rem 1.15rem;
    background: rgba(255, 253, 248, 0.94);
    box-shadow: 0 18px 48px rgba(36, 71, 103, 0.1);
  }

  .contact-form-heading {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    margin-block-end: 1.4rem;
  }

  .contact-form-heading > span {
    display: grid;
    width: 2.1rem;
    height: 2.1rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    background: #e7f1e8;
    color: #608c77;
  }

  .contact-form-heading h2 {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.5;
  }

  .contact-form-heading p {
    margin: 0.2rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }

  .contact-email {
    margin: 1rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.78rem;
    text-align: center;
  }

  .contact-email a {
    color: var(--color-primary);
    font-weight: 800;
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  @media (max-width: 860px) {
    .contact-layout {
      grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.95fr);
      gap: 1.5rem;
    }

    .contact-benefits {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .contact-page {
      padding-block: 2.5rem 3rem;
    }

    .contact-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.2rem;
    }

    .contact-intro h1 {
      font-size: clamp(2.5rem, 12vw, 3.5rem);
    }

    .contact-illustration {
      width: min(100%, 25rem);
      margin: 0.5rem auto 0.2rem;
    }

    .contact-benefits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .contact-form-panel {
      padding: 1.1rem;
    }
  }

  @media (max-width: 380px) {
    .contact-benefits {
      grid-template-columns: 1fr;
    }
  }
</style>
