---
import '../styles/global.css';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#244767" />
    <title>{title}</title>
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      const initializeScrollReveal = () => {
        const root = document.documentElement;
        if (root.dataset.scrollRevealInitialized === 'true') return;

        const targets = Array.from(
          document.querySelectorAll<HTMLElement>('[data-reveal], .animate-on-scroll')
        );

        root.dataset.scrollRevealInitialized = 'true';
        if (!targets.length) return;

        const reducedMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;
        if (reducedMotion || !('IntersectionObserver' in window)) {
          targets.forEach((target) => target.classList.add('is-visible'));
          return;
        }

        let observer: IntersectionObserver | undefined;
        try {
          document.addEventListener('transitionend', (event) => {
            if (
              event.target instanceof HTMLElement &&
              event.propertyName === 'opacity' &&
              event.target.classList.contains('animate-on-scroll')
            ) {
              event.target.classList.remove('is-transitioning');
            }
          });

          observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                const target = entry.target as HTMLElement;
                const isVisible = target.classList.contains('is-visible');
                if (entry.isIntersecting === isVisible) return;

                target.classList.add('is-transitioning');
                target.classList.toggle('is-visible', entry.isIntersecting);
              });
            },
            { threshold: 0.08, rootMargin: '-48px 0px -48px 0px' }
          );

          targets.forEach((target) => {
            observer?.observe(target);
          });
          root.classList.add('has-scroll-reveal');
        } catch (error) {
          observer?.disconnect();
          targets.forEach((target) => {
            target.classList.remove('is-transitioning');
            target.classList.add('is-visible');
          });
          root.classList.remove('has-scroll-reveal');
          console.error('Rehalink scroll reveal initialization failed.', error);
        }
      };

      initializeScrollReveal();
    </script>
  </body>
</html>