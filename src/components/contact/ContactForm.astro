---
import { WHATSAPP_NUMBER, isConfiguredWhatsAppNumber } from '../../data/site';

const hasWhatsAppNumber = isConfiguredWhatsAppNumber(WHATSAPP_NUMBER);
---
<form class="booking-form" id="booking-form" novalidate>
  <div class="booking-field">
    <label for="name">الاسم الكامل <span aria-hidden="true">*</span></label>
    <input
      type="text"
      id="name"
      name="name"
      autocomplete="name"
      maxlength="120"
      required
      aria-required="true"
      placeholder="مثلاً: أمينة بن علي"
      aria-describedby="name-help form-feedback"
    />
    <small id="name-help">الاسم اللي نقدروا نناديوك به.</small>
  </div>

  <div class="booking-field">
    <label for="phone">رقم الهاتف <span aria-hidden="true">*</span></label>
    <input
      type="tel"
      id="phone"
      name="phone"
      dir="ltr"
      inputmode="tel"
      autocomplete="tel"
      maxlength="32"
      required
      aria-required="true"
      placeholder="+213 5 XX XX XX XX"
      aria-describedby="phone-help form-feedback"
    />
    <small id="phone-help">اكتب الرقم مع رمز الدولة إن توفر؛ نقبل تنسيقات هاتف مختلفة.</small>
  </div>

  <p class="booking-form__privacy">
  ما نطلبوش أعراض أو معلومات طبية. اسمك ورقمك يظهرو في رسالة واتساب جاهزة. الرابط يفتح واتساب، لكن الرسالة ما توصلش للفريق حتى تراجعها وتضغط على إرسال.
  </p>

  <button class="booking-form__submit" type="button">
    فتح واتساب
    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
      <path d="M19 12H5m0 0 7 7m-7-7 7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>

  <p class="booking-form__hint">بالضغط، يفتح واتساب برسالة مسبقة التعبئة. راجعها ثم أرسلها بنفسك؛ الضغط هنا لا يرسلها تلقائياً.</p>
  <p class="booking-form__feedback" id="form-feedback" role="status" aria-live="polite"></p>
  {!hasWhatsAppNumber && (
    <p class="booking-form__config-note">
      الإرسال عبر واتساب غير متاح حالياً. على إدارة الموقع إعداد رقم الوجهة قبل استقبال الطلبات.
    </p>
  )}
</form>

<style>
  .booking-form {
    display: grid;
    gap: 1.1rem;
    width: 100%;
  }

  .booking-field {
    display: grid;
    gap: 0.4rem;
  }

  .booking-field label {
    color: var(--color-primary-dark);
    font-size: 0.9rem;
    font-weight: 800;
  }

  .booking-field label span {
    color: #9d554d;
  }

  .booking-field input {
    width: 100%;
    min-height: 3.35rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid #d8d6cd;
    border-radius: 0.8rem;
    background: #fffefa;
    color: var(--color-primary-dark);
    font-size: 1rem;
    transition: border-color 0.18s ease, box-shadow 0.18s ease;
  }

  .booking-field input:focus-visible {
    border-color: #4d806c;
    box-shadow: 0 0 0 3px rgba(77, 128, 108, 0.14);
    outline: none;
  }

  .booking-field input[aria-invalid="true"] {
    border-color: #a84c43;
  }

  .booking-field input::placeholder {
    color: #89919a;
    opacity: 1;
  }

  .booking-field small,
  .booking-form__hint {
    color: var(--color-text-muted);
    font-size: 0.76rem;
    line-height: 1.65;
  }

  .booking-form__privacy,
  .booking-form__hint,
  .booking-form__feedback,
  .booking-form__config-note {
    margin: 0;
  }

  .booking-form__privacy {
    padding: 0.75rem 0.85rem;
    border-inline-start: 3px solid #78a58b;
    border-radius: 0.4rem;
    background: #f0f5ee;
    color: #4a5d62;
    font-size: 0.78rem;
    line-height: 1.75;
  }

  .booking-form__submit {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.75rem 1rem;
    border: 0;
    border-radius: 0.85rem;
    background: var(--color-primary-dark);
    box-shadow: 0 7px 16px rgba(25, 47, 67, 0.16);
    color: #fff;
    cursor: pointer;
    font-weight: 800;
    transition: transform 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
  }

  .booking-form__submit:hover {
    transform: translateY(-1px);
    background: #2b506e;
    box-shadow: 0 10px 20px rgba(25, 47, 67, 0.2);
  }

  .booking-form__submit svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .booking-form__hint,
  .booking-form__feedback {
    text-align: center;
  }

  .booking-form__feedback:not(:empty) {
    color: #8b4138;
    font-size: 0.86rem;
    font-weight: 700;
  }

  .booking-form__feedback[data-state="success"] {
    color: #376d51;
  }

  .booking-form__feedback a {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .booking-form__config-note {
    padding: 0.7rem;
    border-radius: 0.6rem;
    background: #fff2df;
    color: #75501f;
    font-size: 0.78rem;
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .booking-field input,
    .booking-form__submit {
      transition: none;
    }

    .booking-form__submit:hover {
      transform: none;
    }
  }
</style>

<script is:inline define:vars={{ WHATSAPP_NUMBER, hasWhatsAppNumber }}>
  const form = document.getElementById('booking-form');
  const nameInput = document.getElementById('name');
  const phoneInput = document.getElementById('phone');
  const feedback = document.getElementById('form-feedback');
  const submitButton = form?.querySelector('.booking-form__submit');

  if (form && nameInput && phoneInput && feedback && submitButton) {
    const prepareWhatsAppMessage = () => {
      nameInput.setCustomValidity('');
      phoneInput.setCustomValidity('');
      nameInput.removeAttribute('aria-invalid');
      phoneInput.removeAttribute('aria-invalid');

      if (!nameInput.value.trim()) {
        nameInput.setCustomValidity('اكتب اسمك من فضلك.');
        nameInput.setAttribute('aria-invalid', 'true');
      }

      const phoneDigits = phoneInput.value.replace(/\D/g, '');
      if (phoneDigits.length < 7 || phoneDigits.length > 15) {
        phoneInput.setCustomValidity('اكتب رقم هاتف صحيحاً من 7 إلى 15 رقماً، مع رمز الدولة إن توفر.');
        phoneInput.setAttribute('aria-invalid', 'true');
      }

      if (!form.reportValidity()) {
        feedback.dataset.state = 'error';
        feedback.textContent = 'راجع الخانات المطلوبة وصحّح رقم الهاتف قبل المتابعة.';
        form.querySelector('[aria-invalid="true"]')?.focus();
        return;
      }

      if (!hasWhatsAppNumber) {
        feedback.dataset.state = 'error';
        feedback.textContent = 'ما قدرناش نفتح واتساب لأن رقم الوجهة غير مضبوط حالياً. تواصل معنا عبر البريد الإلكتروني.';
        return;
      }

      const message = `مرحبا، أريد حجز تقييم.\nالاسم: ${nameInput.value.trim()}\nالهاتف: ${phoneInput.value.trim()}`;
      const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;
      window.open(url, '_blank', 'noopener,noreferrer');
      feedback.dataset.state = 'success';
      feedback.replaceChildren('إذا ما فتحش واتساب، ');
      const fallbackLink = document.createElement('a');
      fallbackLink.href = url;
      fallbackLink.target = '_blank';
      fallbackLink.rel = 'noopener noreferrer';
      fallbackLink.textContent = 'اضغط هنا لفتحه';
      feedback.append(fallbackLink, '. راجع الرسالة ثم أرسلها من واتساب.');
    };

    submitButton.addEventListener('click', prepareWhatsAppMessage);
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      prepareWhatsAppMessage();
    });

    [nameInput, phoneInput].forEach((input) => {
      input.addEventListener('input', () => {
        input.setCustomValidity('');
        input.removeAttribute('aria-invalid');
        feedback.textContent = '';
        delete feedback.dataset.state;
      });
    });
  }
</script>
