---
import { sitePath } from '../../data/site';
---
<section class="conversion-section" id="booking">
  <div class="container conversion-layout">
    <div class="conversion-art animate-on-scroll animate-on-scroll--strong" data-reveal>
      <span class="conversion-shape conversion-shape--sage" aria-hidden="true"></span>
      <span class="conversion-shape conversion-shape--lavender" aria-hidden="true"></span>
      <img src={sitePath('/images/rehab-support.svg')} alt="" loading="lazy" />
      <div class="appointment-slip">
        <span class="slip-mark" aria-hidden="true">✳</span>
        <span><strong>أول خطوة</strong><small>تبدأ بسؤال</small></span>
      </div>
    </div>

    <div class="conversion-copy animate-on-scroll animate-on-scroll--strong" data-reveal style="--reveal-delay: 100ms;">
      <span class="conversion-kicker">نحن هنا لنسمعك</span>
      <h2>ما تحتاجش تعرف<br /><em>كل الأجوبة من الآن.</em></h2>
      <p>
        إذا كاين شي حاجة مقلقاتك، نبدأو بحوار بسيط. فريقنا يوجّهك للتخصص المناسب
        ويقترح الخطوة الجاية، بلا ما تحتاج تشخيص مسبق.
      </p>
      <a class="conversion-cta" href={sitePath('/contact')}>
        احجز تقييم
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none"><path d="M19 12H5m0 0 7 7m-7-7 7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
      <small class="conversion-privacy">نحتاجو غير اسمك ورقم هاتفك — ما نطلبوش معلومات طبية عبر الموقع.</small>
    </div>
  </div>
</section>

<style>
  .conversion-section {
    position: relative;
    overflow: hidden;
    padding-block: 5rem;
    background: #e8eee7;
  }

  .conversion-section::before {
    position: absolute;
    inset-block-start: -9rem;
    inset-inline-start: -4rem;
    width: 24rem;
    aspect-ratio: 1;
    border: 1px solid rgba(36, 71, 103, 0.12);
    border-radius: 50%;
    content: "";
  }

  .conversion-layout {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .conversion-art {
    position: relative;
    min-height: 350px;
    isolation: isolate;
  }

  .conversion-art > img {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: contain;
    filter: drop-shadow(0 18px 24px rgba(36, 71, 103, 0.1));
  }

  .conversion-shape {
    position: absolute;
    z-index: -1;
    border-radius: 46% 54% 62% 38% / 49% 44% 56% 51%;
  }

  .conversion-shape--sage {
    inset: 3% 8% 2% 5%;
    background: #c6ded0;
    transform: rotate(-13deg);
  }

  .conversion-shape--lavender {
    inset: 15% 1% 12% 13%;
    border: 1px solid rgba(122, 103, 145, 0.3);
    transform: rotate(17deg);
  }

  .appointment-slip {
    position: absolute;
    inset-block-end: 6%;
    inset-inline-end: -2%;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.8rem 1rem;
    border: 1px solid rgba(36, 71, 103, 0.1);
    border-radius: 8px 3px 9px 4px;
    background: #fffdf8;
    box-shadow: 0 10px 24px rgba(36, 71, 103, 0.14);
    transform: rotate(-4deg);
  }

  .slip-mark {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border-radius: 50%;
    background: #e6efe5;
    color: #598b73;
    font-size: 1.2rem;
  }

  .appointment-slip strong,
  .appointment-slip small {
    display: block;
  }

  .appointment-slip strong {
    color: var(--color-primary-dark);
    font-size: 0.85rem;
  }

  .appointment-slip small {
    color: var(--color-text-muted);
    font-size: 0.72rem;
  }

  .conversion-copy {
    max-width: 38rem;
    padding-block: 1rem;
  }

  .conversion-kicker {
    color: #527d68;
    font-size: 0.84rem;
    font-weight: 800;
  }

  .conversion-copy h2 {
    margin: 0.6rem 0 0;
    color: var(--color-primary-dark);
    font-size: clamp(2.5rem, 4.2vw, 4.3rem);
    line-height: 1.2;
    letter-spacing: -0.04em;
  }

  .conversion-copy h2 em {
    color: #628a75;
    font-style: normal;
  }

  .conversion-copy > p {
    max-width: 35rem;
    margin-block: 1.1rem 1.45rem;
    color: #536574;
    font-size: 1.02rem;
    line-height: 1.9;
  }

  .conversion-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 3.15rem;
    padding: 0.75rem 1.35rem;
    border-radius: 999px;
    background: var(--color-primary-dark);
    box-shadow: 0 8px 18px rgba(25, 47, 67, 0.16);
    color: #fff;
    font-weight: 800;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .conversion-cta:hover {
    transform: translateY(-2px);
    background: #2c516f;
  }

  .conversion-cta svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .conversion-privacy {
    display: block;
    margin-block-start: 0.9rem;
    color: #6a7a83;
    font-size: 0.78rem;
    line-height: 1.7;
  }

  @media (max-width: 760px) {
    .conversion-section {
      padding-block: 3.8rem;
    }

    .conversion-layout {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }

    .conversion-art {
      grid-row: 2;
      min-height: 270px;
      max-width: 32rem;
      width: 100%;
      margin-inline: auto;
    }

    .conversion-copy {
      grid-row: 1;
    }

    .conversion-copy h2 {
      font-size: clamp(2.5rem, 10vw, 3.5rem);
    }

    .appointment-slip {
      inset-inline-end: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .conversion-cta {
      transition: none;
    }

    .conversion-cta:hover {
      transform: none;
    }
  }
</style>
