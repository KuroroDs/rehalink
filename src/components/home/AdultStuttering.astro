---
import { sitePath } from '../../data/site';
---
<section class="stuttering-section" id="stuttering-section" aria-labelledby="stuttering-title">
  <div class="container stuttering-layout">
    <div class="stuttering-copy animate-on-scroll" data-reveal>
      <span class="stuttering-overline">للبالغين</span>
      <h2 id="stuttering-title">التأتأة ما تحددش <em>شكون راك.</em></h2>
      <p class="stuttering-supporting">تقدر تبدا رحلة جديدة نحو تواصل يريحك.</p>
      <p class="stuttering-description">
        بزاف من الكبار يعيشو مع التأتأة ويواجهو تحديات في مواقف يومية كيما الخدمة،
        القراية، ولا التواصل مع الآخرين. في RehaLink، نوفرو مساحة للاستماع والتقييم،
        ومواكبة فردية من أخصائي النطق واللغة، حسب احتياجاتك والأهداف اللي تهمك.
      </p>

      <ul class="stuttering-benefits">
        <li><span aria-hidden="true">01</span> تقييم فردي لصعوبات الطلاقة والتواصل</li>
        <li><span aria-hidden="true">02</span> استراتيجيات وتمارين تناسب احتياجاتك</li>
        <li><span aria-hidden="true">03</span> مواكبة للثقة والتعامل مع مواقف الحياة اليومية</li>
      </ul>

      <a class="stuttering-cta" href={sitePath('/contact')}>
        احجز تقييم للتأتأة
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
          <path d="M19 12H5m0 0 7 7m-7-7 7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <p class="stuttering-note">لكل شخص طريقته وأهدافه في التواصل؛ ما كاينش وعد بنتيجة واحدة للجميع.</p>
    </div>

    <figure class="stuttering-art animate-on-scroll animate-on-scroll--scale" data-reveal>
      <span class="stuttering-art__shape stuttering-art__shape--sage" aria-hidden="true"></span>
      <span class="stuttering-art__shape stuttering-art__shape--blue" aria-hidden="true"></span>
      <div class="stuttering-art__frame">
        <img
          src={sitePath('/images/rehab-support.svg')}
          alt="رسم توضيحي لشخص مع عناصر ترمز إلى التقدم والدعم في إعادة التأهيل"
          width="520"
          height="400"
          loading="lazy"
          decoding="async"
        />
        <span class="stuttering-art__label">التواصل يبدأ بالإنصات</span>
      </div>
    </figure>
  </div>
</section>

<style>
  .stuttering-section {
    position: relative;
    overflow: clip;
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
    background:
      radial-gradient(ellipse at 12% 85%, rgba(236, 230, 243, 0.62), transparent 30%),
      linear-gradient(125deg, #edf2ea, #f8f5ed 55%, #f4efe5);
  }

  .stuttering-section::before {
    position: absolute;
    inset-block-start: -12rem;
    inset-inline-end: -7rem;
    width: 30rem;
    aspect-ratio: 1;
    border: 1px solid rgba(36, 71, 103, 0.1);
    border-radius: 50%;
    content: "";
    pointer-events: none;
  }

  .stuttering-layout {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .stuttering-copy {
    min-width: 0;
  }

  .stuttering-overline {
    display: inline-flex;
    padding: 0.32rem 0.75rem;
    border: 1px solid rgba(84, 135, 108, 0.24);
    border-radius: 999px;
    background: rgba(255, 253, 248, 0.78);
    color: #527d68;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .stuttering-copy h2 {
    margin: 0.85rem 0 0;
    font-size: clamp(2.25rem, 4.4vw, 4.1rem);
    line-height: 1.27;
    letter-spacing: -0.035em;
  }

  .stuttering-copy h2 em {
    color: #598771;
    font-style: normal;
  }

  .stuttering-supporting {
    margin: 0.45rem 0 0;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    font-weight: 700;
    line-height: 1.6;
  }

  .stuttering-description {
    max-width: 42rem;
    margin-block: 0.9rem 1.2rem;
    color: #526477;
    font-size: 0.98rem;
    line-height: 2;
  }

  .stuttering-benefits {
    display: grid;
    gap: 0.6rem;
    margin: 0 0 1.4rem;
    padding: 0;
    list-style: none;
  }

  .stuttering-benefits li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    color: #344e5c;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.7;
  }

  .stuttering-benefits li span {
    display: grid;
    width: 1.65rem;
    height: 1.65rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(84, 135, 108, 0.22);
    border-radius: 50%;
    background: #e3eee5;
    color: #527d68;
    font-size: 0.58rem;
    font-weight: 800;
  }

  .stuttering-cta {
    display: inline-flex;
    min-height: 3.15rem;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 0.7rem 1.25rem;
    border: 1px solid rgba(20, 54, 53, 0.1);
    border-radius: 999px;
    background: var(--color-primary-dark);
    box-shadow: 0 8px 18px rgba(25, 47, 67, 0.16);
    color: #fff;
    font-weight: 800;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .stuttering-cta:hover {
    transform: translateY(-2px);
    background: #2b506e;
    box-shadow: 0 12px 24px rgba(25, 47, 67, 0.2);
  }

  .stuttering-cta svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .stuttering-note {
    max-width: 32rem;
    margin-block: 0.8rem 0;
    color: #6b7880;
    font-size: 0.75rem;
    line-height: 1.75;
  }

  .stuttering-art {
    position: relative;
    isolation: isolate;
    min-width: 0;
    margin: 0;
    padding: 1.5rem 1.6rem 2.4rem;
  }

  .stuttering-art__shape {
    position: absolute;
    z-index: -1;
    border-radius: 48% 52% 64% 36% / 43% 42% 58% 57%;
  }

  .stuttering-art__shape--sage {
    inset: 9% 12% 12% 5%;
    background: #cbded0;
    transform: rotate(-9deg);
  }

  .stuttering-art__shape--blue {
    inset: 16% 3% 5% 13%;
    border: 1px solid rgba(36, 71, 103, 0.2);
    transform: rotate(8deg);
  }

  .stuttering-art__frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1.3;
    border: 8px solid rgba(255, 253, 248, 0.9);
    border-radius: 1.6rem 1.2rem 1.8rem 1.15rem;
    background: #e5eee7;
    box-shadow: 0 22px 44px rgba(36, 71, 103, 0.15);
    transform: rotate(-1.2deg);
  }

  .stuttering-art__frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .stuttering-art__label {
    position: absolute;
    inset-inline-start: 1rem;
    inset-block-end: 1rem;
    z-index: 2;
    max-width: calc(100% - 2rem);
    padding: 0.6rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 999px;
    background: rgba(20, 54, 53, 0.88);
    box-shadow: 0 6px 18px rgba(20, 38, 47, 0.2);
    color: #fffdf8;
    font-size: clamp(0.75rem, 2vw, 0.9rem);
    font-weight: 700;
    line-height: 1.5;
    text-align: center;
  }

  @media (max-width: 800px) {
    .stuttering-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      gap: 1.5rem;
    }

    .stuttering-copy h2 {
      font-size: clamp(2rem, 4.6vw, 3rem);
    }

    .stuttering-art {
      padding-inline: 0.5rem;
    }
  }

  @media (max-width: 680px) {
    .stuttering-section {
      padding-block: 3.5rem;
    }

    .stuttering-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.4rem;
    }

    .stuttering-copy h2 {
      font-size: clamp(2.15rem, 9vw, 3.2rem);
    }

    .stuttering-description {
      font-size: 0.94rem;
    }

    .stuttering-art {
      width: min(100%, 30rem);
      margin-inline: auto;
      padding: 1rem 1.1rem 2rem;
    }

    .stuttering-cta {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stuttering-cta {
      transition: none;
    }

    .stuttering-cta:hover {
      transform: none;
    }
  }
</style>
