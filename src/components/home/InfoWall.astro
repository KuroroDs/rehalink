---
import { infoCards } from '../../data/info-cards';
import { sitePath } from '../../data/site';
---
<section class="editorial-info" id="information">
  <div class="container">
    <header class="editorial-info__heading animate-on-scroll" data-reveal>
      <div>
        <span class="info-overline">من دفتر Rehalink</span>
        <h2>معلومة صغيرة،<br /><em>فرق كبير.</em></h2>
      </div>
      <p>ملاحظات ومصادر موثوقة تساعدك تفهم أكثر — وتبقى دائماً للتوعية، ماشي للتشخيص.</p>
    </header>

    <div class="info-collage">
      <!-- The Sticker Piece -->
      <div class="info-art-piece animate-on-scroll" data-reveal>
        <!-- Put your real doctors image here -->
        <img class="info-art-photo" src={sitePath('/images/doctors-photo.jpg')} alt="أخصائيون في Rehalink" loading="lazy" />
        <span class="info-art-caption">خطوة بخطوة،<br />كل تقدّم يهم.</span>
        <span class="info-art-sticker" aria-hidden="true">معلومة<br />موثوقة</span>
        <svg class="info-art-scribble" aria-hidden="true" viewBox="0 0 100 60" fill="none">
          <path d="M4 39c13-22 20-26 31-19 10 6 7 17-1 17-7 0-8-9-2-13 9-6 17 2 24 8 8 7 17 7 39-12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-dasharray="1 6"/>
          <path d="m82 17 13 1-4 11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>

      {infoCards.map((card, index) => (
        <article
          class={`info-paper info-paper--${index + 1} paper-object animate-on-scroll animate-on-scroll--scale`}
          data-reveal
          style={`--reveal-delay: ${index * 120}ms;`}
        >
          <span class="info-paper__pin" aria-hidden="true"></span>
          <span class="info-paper__number">معلومة 0{index + 1}</span>
          <p>{card.text}</p>
          <a href={card.sourceUrl} target="_blank" rel="noopener noreferrer">
            <span>المصدر: {card.sourceLabel}</span>
            <svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><path d="M5 15 15 5M6 5h9v9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </article>
      ))}
    </div>
    <p class="info-footnote animate-on-scroll" data-reveal><span aria-hidden="true">✳</span> للمعلومات العامة فقط — اسأل مختصاً عن احتياجاتك الخاصة.</p>
  </div>
</section>

<style>
  /* Your original CSS remains untouched */
  .editorial-info {
    position: relative;
    overflow: hidden;
    padding-block: 5.5rem 6rem;
    background:
      radial-gradient(ellipse at 88% 15%, rgba(236, 230, 243, 0.52), transparent 34%),
      #fbf8f1;
  }

  .editorial-info__heading {
    display: grid;
    grid-template-columns: 1fr minmax(15rem, 0.6fr);
    align-items: end;
    gap: 2rem;
    margin-block-end: 2.5rem;
  }

  .info-overline {
    color: #6c947b;
    font-size: 0.8rem;
    font-weight: 800;
  }

  .editorial-info__heading h2 {
    margin: 0.4rem 0 0;
    color: var(--color-primary-dark);
    font-size: clamp(2.3rem, 4vw, 3.7rem);
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .editorial-info__heading h2 em {
    color: #6d8d77;
    font-style: normal;
  }

  .editorial-info__heading > p {
    max-width: 27rem;
    margin: 0 0 0.3rem;
    color: var(--color-text-muted);
    font-size: 0.96rem;
    line-height: 1.9;
  }

  .info-collage {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(205px, auto));
    gap: 1rem;
    align-items: stretch;
    padding: 0.7rem 0.35rem 1.2rem;
  }

  .info-art-piece {
    position: relative;
    grid-column: 1 / span 4;
    grid-row: 1 / span 2;
    min-height: 435px;
    overflow: hidden; /* Changed to hidden so image doesn't spill out */
    border-radius: 46% 46% 9px 9px / 25% 25% 9px 9px;
    background: #e7eee4;
    box-shadow: 0 12px 26px rgba(36, 71, 103, 0.1);
  }

  .info-art-piece::before {
    position: absolute;
    inset: 0.7rem -0.7rem -0.7rem 0.7rem;
    z-index: -1;
    border: 1px solid rgba(105, 144, 120, 0.34);
    border-radius: inherit;
    content: "";
  }

  /* NEW: Style for the real photo */
  .info-art-photo {
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    object-position: center;
    border-radius: inherit;
  }

  .info-art-piece::after {
    position: absolute;
    inset: 35% 0 0;
    border-radius: inherit;
    background: linear-gradient(180deg, transparent, rgba(25, 47, 67, 0.84));
    content: "";
    pointer-events: none; /* So the gradient doesn't block clicks */
  }

  .info-art-caption {
    position: absolute;
    inset-block-end: 1.2rem;
    inset-inline-start: 1.3rem;
    z-index: 1;
    color: #fff;
    font-family: var(--font-heading);
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .info-art-sticker {
    position: absolute;
    inset-block-start: 12%;
    inset-inline-start: -0.6rem;
    z-index: 2;
    display: grid;
    width: 4.2rem;
    height: 4.2rem;
    place-items: center;
    border: 1px solid rgba(36, 71, 103, 0.12);
    border-radius: 50%;
    background: #f7efd9;
    box-shadow: 0 5px 12px rgba(36, 71, 103, 0.12);
    color: var(--color-primary);
    font-size: 0.7rem;
    font-weight: 800;
    text-align: center;
    transform: rotate(-12deg);
  }

  .info-art-scribble {
    position: absolute;
    inset-block-start: 0.4rem;
    inset-inline-end: -1.3rem;
    z-index: 2;
    width: 5.8rem;
    color: #5f8c77;
    transform: rotate(8deg);
  }

  /* ... Rest of your paper notes CSS remains exactly the same ... */
  .info-paper {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
    padding: 1.45rem 1.25rem 1.15rem;
    border: 1px solid rgba(36, 71, 103, 0.1);
    box-shadow: 2px 8px 16px rgba(36, 71, 103, 0.09);
    transition: transform 0.24s ease, box-shadow 0.24s ease;
  }

  .info-paper:hover {
    z-index: 2;
    box-shadow: 4px 14px 23px rgba(36, 71, 103, 0.15);
    transform: translateY(-5px) rotate(0deg);
  }

  .info-paper--1 { grid-column: 5 / span 4; grid-row: 1; border-radius: 4px 13px 5px 10px; background: #f7f0dc; transform: rotate(-1.2deg); }
  .info-paper--2 { grid-column: 9 / span 4; grid-row: 1; margin-block-start: 0.8rem; border-radius: 12px 4px 11px 5px; background: #e5eff2; transform: rotate(1deg); }
  .info-paper--3 { grid-column: 5 / span 4; grid-row: 2; margin-block-start: -0.6rem; border-radius: 5px 10px 4px 13px; background: #eee8f3; transform: rotate(0.8deg); }
  .info-paper--4 { grid-column: 9 / span 4; grid-row: 2; margin-block-start: 0.4rem; border-radius: 13px 5px 10px 4px; background: #e7eee4; transform: rotate(-0.8deg); }
  .info-paper--5 { grid-column: 2 / span 4; grid-row: 3; margin-block-start: -0.5rem; border-radius: 4px 12px 5px 13px; background: #f5e9ee; transform: rotate(-1deg); }

  .info-paper__pin {
    position: absolute;
    inset-block-start: 0.55rem;
    inset-inline-start: 50%;
    width: 0.7rem;
    height: 0.7rem;
    border: 2px solid rgba(255, 255, 255, 0.85);
    border-radius: 50%;
    background: #bd705f;
    box-shadow: 0 2px 4px rgba(36, 71, 103, 0.2);
    transform: translateX(-50%);
  }

  .info-paper--2 .info-paper__pin,
  .info-paper--4 .info-paper__pin {
    width: 3rem;
    height: 0.8rem;
    border: 0;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.62);
    box-shadow: 0 2px 4px rgba(36, 71, 103, 0.08);
  }

  .info-paper__number { margin-block-end: 0.6rem; color: #678873; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.06em; }
  .info-paper > p { margin: 0 0 1rem; color: #364b5f; font-size: 0.88rem; line-height: 1.85; }
  .info-paper > a { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; width: fit-content; max-width: 100%; padding-block-start: 0.6rem; border-block-start: 1px solid rgba(36, 71, 103, 0.15); color: var(--color-primary); font-size: 0.72rem; font-weight: 800; line-height: 1.6; text-decoration: underline; text-decoration-color: rgba(36, 71, 103, 0.3); text-underline-offset: 3px; }
  .info-paper > a svg { flex: 0 0 auto; width: 1rem; height: 1rem; }
  .info-footnote { display: flex; align-items: center; gap: 0.5rem; margin: 1.4rem 0 0; color: #738077; font-size: 0.77rem; }
  .info-footnote span { color: #719778; font-size: 1.1rem; }

  @media (max-width: 900px) {
    .info-collage { grid-template-rows: repeat(3, minmax(200px, auto)); }
    .info-art-piece { grid-column: 1 / span 5; grid-row: 1 / span 2; }
    .info-paper--1 { grid-column: 6 / span 7; grid-row: 1; }
    .info-paper--2 { grid-column: 6 / span 7; grid-row: 2; margin-block-start: 0; }
    .info-paper--3 { grid-column: 1 / span 6; grid-row: 3; margin-block-start: 0; }
    .info-paper--4 { grid-column: 7 / span 6; grid-row: 3; margin-block-start: 0; }
    .info-paper--5 { grid-column: 4 / span 6; grid-row: 4; margin-block-start: 0; }
  }

  @media (max-width: 620px) {
    .editorial-info { padding-block: 3.7rem 4rem; }
    .editorial-info__heading { grid-template-columns: 1fr; gap: 0.75rem; margin-block-end: 1.6rem; }
    .info-collage { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto; gap: 1.1rem; padding-inline: 0.35rem; }
    .info-art-piece { grid-column: 1; grid-row: auto; min-height: 250px; max-height: 300px; margin-inline: 0.5rem; }
    .info-paper--1, .info-paper--2, .info-paper--3, .info-paper--4, .info-paper--5 { grid-column: 1; grid-row: auto; min-height: 190px; margin: 0 0.25rem; }
    .info-paper--2, .info-paper--5 { margin-inline-start: 0.85rem; }
    .info-paper--3 { margin-inline-end: 0.85rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .info-paper { transition: none; }
    .info-paper:hover { transform: none; }
  }
</style>